datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  ORGANIZER
  PLAYER
  REFEREE
}

enum TournamentFormat {
  SOLO
  DUO
  SQUAD
}

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ParticipantStatus {
  REGISTERED
  CHECKED_IN
  DISQUALIFIED
  ELIMINATED
}

enum MatchStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  DISPUTED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         Role      @default(PLAYER)
  isBanned     Boolean   @default(false) @map("is_banned")
  banReason    String?   @map("ban_reason") @db.Text
  bio          String?   @db.Text
  avatarUrl    String?   @map("avatar_url") @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  createdGames         Game[]                  @relation("AdminCreatedGames")
  organizedTournaments Tournament[]            @relation("OrganizerTournaments")
  captainTeams         Team[]                  @relation("TeamCaptain")
  teamMemberships      TeamMember[]
  participations       TournamentParticipant[]
  adjudicatedMatches   Match[]                 @relation("RefereeMatches")

  @@index([role, isBanned])
  @@map("users")
}

model Game {
  id          String        @id @default(uuid()) @db.Uuid
  title       String        @unique @db.VarChar(100)
  slug        String        @unique @db.VarChar(100)
  genre       String        @db.VarChar(50)
  platform    String        @default("PC") @db.VarChar(50)
  coverImage  String?       @map("cover_image") @db.VarChar(255)
  isTeamBased Boolean       @default(false) @map("is_team_based")
  minTeamSize Int           @default(1) @map("min_team_size")
  maxTeamSize Int           @default(1) @map("max_team_size")
  metadata    Json?         @default("{}")
  createdById String?       @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  createdBy   User?         @relation("AdminCreatedGames", fields: [createdById], references: [id], onDelete: SetNull)
  tournaments Tournament[]

  @@map("games")
}

model Tournament {
  id              String            @id @default(uuid()) @db.Uuid
  title           String            @db.VarChar(150)
  slug            String            @unique @db.VarChar(160)
  description     String?           @db.Text
  bannerImage     String?           @map("banner_image") @db.VarChar(255)
  prizePool       String?           @map("prize_pool") @db.VarChar(50)
  structure       String            @default("SINGLE_ELIMINATION") @db.VarChar(50)
  gameId          String            @map("game_id") @db.Uuid
  organizerId     String            @map("organizer_id") @db.Uuid
  format          TournamentFormat  @default(SOLO)
  status          TournamentStatus  @default(DRAFT)
  maxParticipants Int               @map("max_participants")
  currentCount    Int               @default(0) @map("current_count")
  rules           Json?             @default("{}")
  startDate       DateTime          @map("start_date")
  endDate         DateTime?         @map("end_date")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  game            Game                   @relation(fields: [gameId], references: [id], onDelete: Restrict)
  organizer       User                   @relation("OrganizerTournaments", fields: [organizerId], references: [id], onDelete: Cascade)
  teams           Team[]
  participants    TournamentParticipant[]
  rounds          Round[]
  matches         Match[]

  @@index([organizerId, status])
  @@index([status, startDate])
  @@index([gameId])
  @@map("tournaments")
}

model Team {
  id           String                  @id @default(uuid()) @db.Uuid
  tournamentId String                  @map("tournament_id") @db.Uuid
  name         String                  @db.VarChar(100)
  tag          String?                 @db.VarChar(10)
  captainId    String                  @map("captain_id") @db.Uuid
  createdAt    DateTime                @default(now()) @map("created_at")

  tournament   Tournament              @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  captain      User                    @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: Restrict)
  members      TeamMember[]
  participants TournamentParticipant[]

  @@unique([tournamentId, name])
  @@index([tournamentId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("STARTER") @db.VarChar(20)
  joinedAt  DateTime @default(now()) @map("joined_at")

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model TournamentParticipant {
  id               String            @id @default(uuid()) @db.Uuid
  tournamentId     String            @map("tournament_id") @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  teamId           String?           @map("team_id") @db.Uuid
  status           ParticipantStatus @default(REGISTERED)
  seed             Int?
  disqualifiedBy   String?           @map("disqualified_by") @db.Uuid
  disqualifyReason String?           @map("disqualify_reason") @db.Text
  registeredAt     DateTime          @default(now()) @map("registered_at")

  tournament       Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  team             Team?             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matchResults     MatchResult[]

  @@unique([tournamentId, userId])
  @@index([tournamentId, status])
  @@index([userId])
  @@map("tournament_participants")
}

model Round {
  id           String     @id @default(uuid()) @db.Uuid
  tournamentId String     @map("tournament_id") @db.Uuid
  roundNumber  Int        @map("round_number")
  name         String     @db.VarChar(50)
  createdAt    DateTime   @default(now()) @map("created_at")

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches      Match[]

  @@unique([tournamentId, roundNumber])
  @@map("rounds")
}

model Match {
  id           String        @id @default(uuid()) @db.Uuid
  tournamentId String        @map("tournament_id") @db.Uuid
  roundId      String        @map("round_id") @db.Uuid
  matchNumber  Int           @map("match_number")
  refereeId    String?       @map("referee_id") @db.Uuid
  status       MatchStatus   @default(PENDING)
  scheduledAt  DateTime?     @map("scheduled_at")
  completedAt  DateTime?     @map("completed_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        Round         @relation(fields: [roundId], references: [id], onDelete: Cascade)
  referee      User?         @relation("RefereeMatches", fields: [refereeId], references: [id], onDelete: SetNull)
  results      MatchResult[]

  @@unique([roundId, matchNumber])
  @@index([tournamentId, roundId])
  @@index([refereeId, status])
  @@map("matches")
}

model MatchResult {
  id            String                @id @default(uuid()) @db.Uuid
  matchId       String                @map("match_id") @db.Uuid
  participantId String                @map("participant_id") @db.Uuid
  score         Int                   @default(0)
  kills         Int?                  @default(0)
  placement     Int?
  isWinner      Boolean               @default(false) @map("is_winner")
  metadata      Json?                 @default("{}")
  submittedAt   DateTime              @default(now()) @map("submitted_at")

  match         Match                 @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participant   TournamentParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([matchId, participantId])
  @@index([participantId])
  @@map("match_results")
}
