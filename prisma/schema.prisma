datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =========================================================================
// USER & ROLE-BASED ACCESS CONTROL
// Roles: ADMIN | ORGANIZER | PLAYER | REFEREE
// =========================================================================
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  passwordHash String    @map("password_hash")
  role         String    @default("PLAYER") // "ADMIN" | "ORGANIZER" | "PLAYER" | "REFEREE"
  isBanned     Boolean   @default(false) @map("is_banned")
  banReason    String?   @map("ban_reason")
  bio          String?
  avatarUrl    String?   @map("avatar_url")
  isEmailVerified          Boolean   @default(false) @map("is_email_verified")
  emailVerificationToken   String?   @map("email_verification_token")
  emailVerificationExpires DateTime? @map("email_verification_expires")
  passwordResetToken       String?   @map("password_reset_token")
  passwordResetExpires     DateTime? @map("password_reset_expires")
  pendingEmail             String?   @map("pending_email")
  emailChangeToken         String?   @map("email_change_token")
  emailChangeExpires       DateTime? @map("email_change_expires")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")


  // Relations
  createdGames         Game[]                  @relation("AdminCreatedGames")
  organizedTournaments Tournament[]            @relation("OrganizerTournaments")
  captainTeams         Team[]                  @relation("TeamCaptain")
  teamMemberships      TeamMember[]
  participations       TournamentParticipant[]
  adjudicatedMatches   Match[]                 @relation("RefereeMatches")
  verifiedMatches      Match[]                 @relation("RefereeVerifiedMatches")
  raisedDisputes       Dispute[]               @relation("ClaimantDisputes")
  resolvedDisputes     Dispute[]               @relation("ResolvedDisputes")
  notifications        Notification[]          @relation("UserNotifications")
  auditLogs            AuditLog[]              @relation("ActorAuditLogs")

  @@index([role, isBanned])
  @@map("users")
}

// =========================================================================
// GAME CATALOG (Admin-Only Creation & Oversight)
// =========================================================================
model Game {
  id          String        @id @default(uuid())
  title       String        @unique
  slug        String        @unique
  genre       String
  platform    String        @default("PC") // PC, Console, Mobile, Cross-Platform
  coverImage  String?       @map("cover_image")
  isTeamBased Boolean       @default(false) @map("is_team_based")
  minTeamSize Int           @default(1) @map("min_team_size")
  maxTeamSize Int           @default(1) @map("max_team_size")
  isActive    Boolean       @default(true) @map("is_active")
  metadata    String?       @default("{}")
  createdById String?       @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  createdBy   User?         @relation("AdminCreatedGames", fields: [createdById], references: [id], onDelete: SetNull)
  tournaments Tournament[]

  @@map("games")
}

// =========================================================================
// TOURNAMENT AGGREGATE (Admin & Organizer Scoped)
// Formats: "SOLO" | "DUO" | "SQUAD"
// Status: "DRAFT" | "REGISTRATION_OPEN" | "IN_PROGRESS" | "COMPLETED" | "CANCELLED"
// =========================================================================
model Tournament {
  id              String            @id @default(uuid())
  title           String
  slug            String            @unique
  description     String?
  bannerImage     String?           @map("banner_image")
  prizePool       String?           @map("prize_pool")
  structure       String            @default("SINGLE_ELIMINATION") // "SINGLE_ELIMINATION" | "ROUND_ROBIN" | "LEADERBOARD_POINTS"
  gameId          String            @map("game_id")
  organizerId     String            @map("organizer_id")
  format          String            @default("SOLO") // "SOLO" | "DUO" | "SQUAD"
  status          String            @default("DRAFT") // "DRAFT" | "REGISTRATION_OPEN" | "IN_PROGRESS" | "COMPLETED" | "CANCELLED"
  maxParticipants Int               @map("max_participants")
  currentCount    Int               @default(0) @map("current_count")
  rules           String?           @default("{}")
  registrationStartDate DateTime    @default(now()) @map("registration_start_date")
  registrationEndDate   DateTime    @default(now()) @map("registration_end_date")
  startDate       DateTime          @map("start_date")
  endDate         DateTime?         @map("end_date")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  // Scoped Relations
  game            Game                   @relation(fields: [gameId], references: [id], onDelete: Restrict)
  organizer       User                   @relation("OrganizerTournaments", fields: [organizerId], references: [id], onDelete: Cascade)
  teams           Team[]
  participants    TournamentParticipant[]
  rounds          MatchRound[]
  matches         Match[]
  disputes        Dispute[]

  @@index([organizerId, status])
  @@index([status, startDate])
  @@index([status, gameId])
  @@index([gameId])
  @@map("tournaments")
}

// =========================================================================
// TEAMS (Strictly instantiated only for DUO and SQUAD tournaments)
// Bypassed for SOLO tournaments.
// =========================================================================
model Team {
  id           String                  @id @default(uuid())
  tournamentId String                  @map("tournament_id")
  name         String
  tag          String?
  inviteCode   String?                 @unique @map("invite_code")
  captainId    String                  @map("captain_id")
  createdAt    DateTime                @default(now()) @map("created_at")

  tournament   Tournament              @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  captain      User                    @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: Restrict)
  members      TeamMember[]
  participants TournamentParticipant[]

  @@unique([tournamentId, name])
  @@index([tournamentId])
  @@index([inviteCode])
  @@index([tournamentId, inviteCode])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  role      String   @default("STARTER") // "CAPTAIN" | "STARTER" | "SUBSTITUTE"
  joinedAt  DateTime @default(now()) @map("joined_at")

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

// =========================================================================
// TOURNAMENT PARTICIPANTS (Player registrations scoped to a tournament)
// When format is SOLO: teamId MUST be null.
// When format is DUO/SQUAD: teamId points to the Team record.
// =========================================================================
model TournamentParticipant {
  id               String        @id @default(uuid())
  tournamentId     String        @map("tournament_id")
  userId           String        @map("user_id")
  teamId           String?       @map("team_id")
  inGameName       String?       @map("in_game_name")
  status           String        @default("REGISTERED") // "REGISTERED" | "CHECKED_IN" | "NO_SHOW" | "DISQUALIFIED" | "ELIMINATED"
  seed             Int?
  disqualifiedBy   String?       @map("disqualified_by")
  disqualifyReason String?       @map("disqualify_reason")
  registeredAt     DateTime      @default(now()) @map("registered_at")

  tournament       Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  team             Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matchResults     ScoreRecord[]

  @@unique([tournamentId, userId])
  @@index([tournamentId, userId])
  @@index([tournamentId, status])
  @@index([userId])
  @@map("tournament_participants")
}

// =========================================================================
// ROUNDS, MATCHES & SCORES (Strictly scoped to tournament)
// Core models: MatchRound, Match, ScoreRecord
// =========================================================================
model MatchRound {
  id           String     @id @default(uuid())
  tournamentId String     @map("tournament_id")
  roundNumber  Int        @map("round_number")
  name         String
  stage        String?    @default("QUARTERFINALS") // "ROUND_OF_16" | "QUARTERFINALS" | "SEMIFINALS" | "FINALS" | "MATCH"
  createdAt    DateTime   @default(now()) @map("created_at")

  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches      Match[]

  @@unique([tournamentId, roundNumber])
  @@map("rounds")
}

model Match {
  id                String        @id @default(uuid())
  tournamentId      String        @map("tournament_id")
  roundId           String        @map("round_id")
  matchNumber       Int           @map("match_number")
  refereeId         String?       @map("referee_id")
  status            String        @default("PENDING") // "PENDING" | "SCHEDULED" | "IN_PROGRESS" | "COMPLETED" | "DISPUTED"
  isVerified        Boolean       @default(false) @map("is_verified")
  verifiedById      String?       @map("verified_by_id")
  verifiedAt        DateTime?     @map("verified_at")
  verificationNotes String?       @map("verification_notes")
  nextMatchId       String?       @map("next_match_id")
  nextMatchSlot     Int?          @map("next_match_slot") // 1 or 2
  customRoomId       String?       @map("custom_room_id")
  customRoomPassword String?       @map("custom_room_password")
  roomInstructions   String?       @map("room_instructions")
  scheduledAt       DateTime?     @map("scheduled_at")
  completedAt       DateTime?     @map("completed_at")
  createdAt         DateTime      @default(now()) @map("created_at")

  tournament        Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round             MatchRound    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  referee           User?         @relation("RefereeMatches", fields: [refereeId], references: [id], onDelete: SetNull)
  verifiedBy        User?         @relation("RefereeVerifiedMatches", fields: [verifiedById], references: [id], onDelete: SetNull)
  results           ScoreRecord[]
  disputes          Dispute[]

  @@unique([roundId, matchNumber])
  @@index([tournamentId, roundId, matchNumber])
  @@index([tournamentId, status])
  @@index([refereeId, status])
  @@index([isVerified])
  @@map("matches")
}

model ScoreRecord {
  id            String                @id @default(uuid())
  tournamentId  String?               @map("tournament_id")
  roundNumber   Int?                  @map("round_number")
  matchId       String                @map("match_id")
  participantId String                @map("participant_id")
  score         Int                   @default(0)
  kills         Int?                  @default(0)
  placement     Int?
  isWinner      Boolean               @default(false) @map("is_winner")
  metadata      String?               @default("{}")
  submittedAt   DateTime              @default(now()) @map("submitted_at")

  match         Match                 @relation(fields: [matchId], references: [id], onDelete: Cascade)
  participant   TournamentParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([matchId, participantId])
  @@index([tournamentId, matchId, roundNumber])
  @@index([matchId, isWinner])
  @@index([participantId])
  @@map("match_results")
}

// =========================================================================
// DISPUTES (Match & Rule Violation Ticketing Engine)
// =========================================================================
model Dispute {
  id              String      @id @default(uuid())
  tournamentId    String      @map("tournament_id")
  matchId         String      @map("match_id")
  claimantId      String      @map("claimant_id")
  reason          String      // CHEATING | INCORRECT_SCORE | TOXIC_CONDUCT | NO_SHOW | OTHER
  description     String
  proofUrl        String?     @map("proof_url")
  status          String      @default("OPEN") // OPEN | INVESTIGATING | RESOLVED | DISMISSED
  resolutionNotes String?     @map("resolution_notes")
  resolvedById    String?     @map("resolved_by_id")
  resolvedAt      DateTime?   @map("resolved_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  tournament      Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  match           Match       @relation(fields: [matchId], references: [id], onDelete: Cascade)
  claimant        User        @relation("ClaimantDisputes", fields: [claimantId], references: [id], onDelete: Cascade)
  resolvedBy      User?       @relation("ResolvedDisputes", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([tournamentId, status])
  @@index([matchId])
  @@index([claimantId])
  @@map("disputes")
}

// =========================================================================
// NOTIFICATIONS (Real-Time & In-App Alerts)
// =========================================================================
model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String
  type      String   // INVITE | MATCH_START | SCORE_UPDATE | BAN | DISPUTE | CHECK_IN | SYSTEM
  isRead    Boolean  @default(false) @map("is_read")
  link      String?
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// =========================================================================
// AUDIT LOGS (Admin View Platform Trail)
// =========================================================================
model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?  @map("actor_id")
  action       String   // GAME_CREATE, TOURNAMENT_DELETE, USER_BAN, SCORE_OVERRIDE, REFEREE_VERIFIED, DISPUTE_RESOLVED, CHECKIN_UPDATE
  targetEntity String   @map("target_entity") // GAME | TOURNAMENT | USER | MATCH | SCORE | DISPUTE
  targetId     String?  @map("target_id")
  ipAddress    String?  @map("ip_address")
  details      String?  @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  actor        User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([actorId])
  @@index([targetEntity, targetId])
  @@map("audit_logs")
}
