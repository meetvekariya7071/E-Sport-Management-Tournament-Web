# ==============================================================================
# E-SPORTS TOURNAMENT MANAGEMENT SYSTEM (ETMS) - CLIENT ENVIRONMENT CONFIGURATION
# Copy this file to client/.env for client runtime configuration
# ==============================================================================

# API Base URL (Relative /api works seamlessly with Vite dev proxy and Nginx reverse proxy)
VITE_API_BASE_URL=/api

# Real-Time WebSocket Server URI (Socket.io)
VITE_SOCKET_URL=http://localhost:5000
