# Backend REST API Base URL
# In production with Nginx reverse proxy, use relative path: /api
VITE_API_URL=/api

# Real-Time WebSocket Server URL (Socket.IO)
# Leave empty for same-origin proxy via /socket.io, or provide full URL (e.g. http://localhost:5000)
VITE_SOCKET_URL=/
