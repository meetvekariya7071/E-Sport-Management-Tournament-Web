# ==============================================================================
# E-SPORTS TOURNAMENT MANAGEMENT SYSTEM (ETMS) - SERVER ENVIRONMENT CONFIGURATION
# Copy this file to .env and customize values for production deployment
# ==============================================================================

# Application Port & Node Environment
PORT=5000
NODE_ENV=production

# Security & JSON Web Token (JWT) Configuration
# IMPORTANT: Generate a cryptographically secure random string in production (e.g., openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_in_production
JWT_EXPIRES_IN=7d

# Database Connection URI
# Local development default (SQLite):
# DATABASE_URL="file:./dev.db"
#
# Production / Docker Compose (PostgreSQL):
DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/esports_db?schema=public

# Allowed CORS Origins (comma-separated or explicit frontend domain)
CORS_ORIGIN=http://localhost:3000,http://localhost:80

# In-Memory Cache TTL (seconds)
CACHE_TTL_SECONDS=30
