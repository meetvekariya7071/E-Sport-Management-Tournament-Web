# =========================================================================
# LEAGUEFORGE - ESPORTS TOURNAMENT MANAGEMENT SYSTEM - SERVER CONFIG
# =========================================================================

# Application Server
PORT=5000
NODE_ENV=production

# JSON Web Token (JWT) Security
# IMPORTANT: Generate a cryptographically secure 256-bit string in production!
JWT_SECRET=super_secure_production_jwt_secret_key_change_me_in_prod_2026
JWT_EXPIRES_IN=7d

# Database Connection URL
# PostgreSQL (Production / Docker Compose):
DATABASE_URL=postgresql://etms_user:etms_password_2026@postgres:5432/etms_db?schema=public

# SQLite (Local Development):
# DATABASE_URL="file:./prisma/dev.db"

# CORS Allowed Origins (Comma-separated URLs)
CORS_ORIGIN=http://localhost:3000,http://localhost:80,http://localhost

# In-Memory Cache & Messaging (Redis)
REDIS_URL=redis://redis:6379

# Client URL (For email verification and password reset links)
CLIENT_URL=http://localhost:3000

# SMTP Email Configuration (Nodemailer / Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=mvekariya2006@gmail.com
# For Gmail, generate a 16-character Google App Password (remove spaces if pasted directly)
SMTP_PASS=your-google-app-password
EMAIL_FROM="LeagueForge Arena <mvekariya2006@gmail.com>"

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=etms_user
POSTGRES_PASSWORD=etms_password_2026
POSTGRES_DB=etms_db
